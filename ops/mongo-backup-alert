#!/usr/bin/env python3
"""Email the operator about a failed or overdue MongoDB backup."""
import argparse
from datetime import datetime, timedelta, timezone
from email.message import EmailMessage
import json
import os
from pathlib import Path
import smtplib
import ssl
import sys


def overdue(marker, now):
    deadline = now.replace(hour=5, minute=0, second=0, microsecond=0)
    if now < deadline:
        deadline -= timedelta(days=1)
    expected_start = deadline.replace(hour=3)
    try:
        return marker.stat().st_mtime < expected_start.timestamp()
    except FileNotFoundError:
        return True


def notify(config, message):
    if config.stat().st_mode & 0o077:
        raise RuntimeError('SMTP config must only be accessible by its owner')
    settings = json.loads(config.read_text(encoding='utf-8'))
    host, port = settings['host'], settings['port']
    if port not in (465, 587):
        raise ValueError('SMTP requires port 465 (TLS) or 587 (STARTTLS)')

    email = EmailMessage()
    email['From'] = settings['from']
    email['To'] = settings['to']
    email['Subject'] = '[Hot Hair 生产] ' + message
    email.set_content(message + '\n备份日志：/root/mongo_backup.log')

    tls = ssl.create_default_context()
    smtp = (smtplib.SMTP_SSL(host, port, timeout=10, context=tls)
            if port == 465 else smtplib.SMTP(host, port, timeout=10))
    with smtp as client:
        if port == 587:
            client.starttls(context=tls)
        client.login(settings.get('username', settings['from']), settings['password'])
        if client.send_message(email):
            raise RuntimeError('SMTP rejected a recipient')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', choices=['failed', 'overdue', 'test'])
    mode = parser.parse_args().mode
    messages = {
        'failed': 'MongoDB 备份任务失败，请检查服务器备份日志。',
        'overdue': 'MongoDB 备份逾期：未发现本轮经过 OSS 回读校验的成功记录。',
        'test': 'MongoDB 备份告警测试，当前无需处理。',
    }
    if mode == 'overdue':
        marker = Path(os.environ.get('BACKUP_DIR', '/data/backup/mongodb')) / 'last-success.json'
        now = datetime.now(timezone(timedelta(hours=8)))
        if not overdue(marker, now):
            return
    config = Path('/root/.config/hot-hair/mongo-backup-alert.json')
    notify(config, messages[mode])
    print('MongoDB backup notification sent: ' + mode)


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        # SMTP errors may include private configuration or recipient details.
        print('MongoDB backup notification failed: ' + type(error).__name__, file=sys.stderr)
        sys.exit(1)
